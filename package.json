{
  "name": "shelfie",
  "version": "0.5.1",
  "description": "Self-hosted pantry tracker with expiry alerts and offline capture.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "SHELFIE_API_ONLY=1 node --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "dev:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy",
    "deploy:local": "npm run build && wrangler deploy -c wrangler.local.jsonc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "hono": "^4.13.16",
    "preact": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "cloudflare": {
    "bindings": {
      "SHELFIE_SETUP_TOKEN": {
        "description": "Needed once, to create the first account. Make one up, or run `openssl rand -hex 16`. Keep it; you type it on the first-run screen."
      }
    }
  }
}
