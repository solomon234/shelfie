{
  "name": "shelfie",
  "version": "0.3.0",
  "description": "Self-hosted pantry tracker with expiry alerts and offline capture.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "SHELFIE_API_ONLY=1 node --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "hono": "^4.13.16",
    "preact": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
